NODE_ENV=development
PORT=4000
HOST=0.0.0.0
FRONTEND_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/casper
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

API_KEY_ENCRYPTION_SECRET=replace-with-32-byte-minimum-random-secret
BYBIT_BASE_URL=https://api-testnet.bybit.com
BYBIT_ENABLE_LIVE_TRADING=false
COINBASE_BASE_URL=https://api.coinbase.com
COINBASE_ENABLE_LIVE_TRADING=false
COINBASE_QUOTE_CURRENCY=USDC
MARKET_DATA_MODE=mock
TRADING_PAIRS=BTCUSDT,ETHUSDT,SOLUSDT,DOGEUSDT,ADAUSDT,MATICUSDT,AVAXUSDT,DOTUSDT
