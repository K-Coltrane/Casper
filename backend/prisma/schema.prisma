generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settings  Settings?
  portfolio Portfolio?
  trades    Trade[]
  apiKeys   ApiKey[]

  @@map("users")
}

model Portfolio {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Float    @default(0)
  pnlToday  Float    @default(0)
  totalPnL  Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("portfolios")
}

model Trade {
  id         String    @id @default(cuid())
  userId     String
  symbol     String
  side       String
  entryPrice Float
  exitPrice  Float?
  quantity   Float
  pnl        Float?
  status     String
  createdAt  DateTime  @default(now())
  closedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([symbol])
  @@map("trades")
}

model ApiKey {
  id        String   @id @default(cuid())
  userId    String
  apiKey    String
  secret    String
  exchange  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, exchange])
  @@map("api_keys")
}

model Settings {
  id                 String   @id @default(cuid())
  userId             String   @unique
  maxTradePercent    Float    @default(0.1)
  dailyLossLimit     Float    @default(100)
  dailyTarget        Float    @default(250)
  strategy           String   @default("balanced")
  memeCoins          Boolean  @default(false)
  botEnabled         Boolean  @default(false)
  maxTradesPerDay    Int      @default(5)
  maxDrawdownPercent Float    @default(10)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("settings")
}

model MarketSnapshot {
  id         String   @id @default(cuid())
  symbol     String
  price      Float
  volume     Float
  volatility Float
  source     String   @default("BYBIT")
  createdAt  DateTime @default(now())

  @@index([symbol, createdAt])
  @@map("market_snapshots")
}

model BotState {
  id               String   @id @default("global")
  enabled          Boolean  @default(false)
  emergencyStopped Boolean  @default(false)
  reason           String?
  updatedAt        DateTime @updatedAt

  @@map("bot_state")
}
